<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org">
<suite name="Full Regression Suite" parallel="tests" thread-count="2" verbose="2">
    
    <test name="Deep Regression Executions - Chrome">
        <parameter name="browser" value="chrome" />
        <classes>
            <class name="com.automation.tests.LoginTest"/>
            <class name="com.automation.tests.WebInputsTest"/>
        </classes>
    </test>

    <test name="Deep Regression Executions - Edge">
        <parameter name="browser" value="edge" />
        <classes>
             <class name="com.automation.tests.LoginTest"/>
            <class name="com.automation.tests.WebInputsTest"/>
        </classes>
    </test>
    
</suite>
